# Line endings.
#
# Store LF in the repository AND check out LF in the working tree, on every
# platform. This matters more here than in a normal project: client projects
# receive changes via `git merge upstream/main`, and line-ending churn turns a
# one-line update into a whole-file conflict.
#
# It also matches `.editorconfig` (`end_of_line = lf`), and the deploy target
# is Linux.
* text=auto eol=lf

# Windows-only shells still need CRLF to behave.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never normalise, never attempt a textual diff.
*.db      binary
*.db-wal  binary
*.db-shm  binary
*.node    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.pdf     binary

# Generated by npm. Keep it diffable, but let GitHub collapse it in review.
package-lock.json linguist-generated=true
