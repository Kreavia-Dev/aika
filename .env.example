# Aika: development environment.
# Copy to `.env` and adjust. Never commit `.env`.
#
# PORT is read by Nuxt/Nitro directly, not by application config.
# See shared/config/env.ts for why it is not in the validated schema.

NODE_ENV=development
PORT=5555
APP_URL=http://localhost:5555
APP_VERSION=0.1.0

# Local SQLite file. Kept out of git by .gitignore.
DATABASE_PATH=./database/aika.db

# Where uploaded files are written. Relative in development, so a fresh clone
# needs no setup. On a server this must be absolute and outside the application
# directory, or a deploy that replaces that directory takes the files with it.
MEDIA_ROOT=./storage/media

LOG_LEVEL=debug
