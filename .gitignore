node_modules/
.nuxt/
.output/
dist/
coverage/

# Environment: never commit. Templates are explicitly un-ignored below.
.env
.env.*
!.env.example
!.env.production.example

# SQLite database, WAL sidecars, and backups are runtime state, not source.
database/*.db
database/*.db-wal
database/*.db-shm
database/backups/

# Uploaded files are runtime state, like the database. The directory itself is
# tracked so that the layout map in docs/aika/README.md stays honest; its
# contents are not.
storage/*
!storage/.gitkeep
logs/
*.log

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
