# Aika: production environment template.
# On the VPS this lives at /etc/aika/env and is NOT inside the repository.
# Referenced by `ecosystem.config.cjs` via node_args --env-file-if-exists.
#
# PORT is read by Nuxt/Nitro directly. If it disagrees with the reverse proxy
# upstream, the site 502s. So keep both in one place: this file.

NODE_ENV=production
PORT=5555

# Required in production. Aika refuses to boot without an explicit public URL.
APP_URL=https://contoh-klien.example.id
APP_VERSION=0.1.0

# Absolute path on the VPS. Must be local storage, never a network filesystem.
DATABASE_PATH=/srv/aika/database/aika.db

LOG_LEVEL=info
